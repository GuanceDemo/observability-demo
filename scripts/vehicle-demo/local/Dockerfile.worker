FROM python:3.12-slim-bookworm@sha256:8a7e7cc04fd3e2bd787f7f24e22d5d119aa590d429b50c95dfe12b3abe52f48b
RUN pip install --no-cache-dir websocket-client==1.9.0
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
# Actual fixed source is delivered by worker_manifest and hash-annotated per Job.
CMD ["python", "-c", "raise SystemExit('Use the dedicated vehicle worker manifest')"]
