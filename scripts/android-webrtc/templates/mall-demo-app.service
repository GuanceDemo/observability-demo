[Unit]
Description=Install the latest Mall Demo APK and show Android Home
After=mall-demo-emulator.service
Requires=mall-demo-emulator.service

[Service]
Type=oneshot
User=cherry
Group=cherry
Environment=HOME=/home/cherry
Environment=ANDROID_SERIAL=emulator-5554
ExecStart=/usr/local/bin/mall-demo-start-app
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
