+async def handle_frame_refresh(request):
+    """
+    POST /api/v1/emulator/refresh-frame
+    Requests one side-effect-free redraw from the configured APK. The ADB
+    executable, serial, package, activity, and action are fixed by the service;
+    the HTTP caller cannot provide a shell command or target.
+    """
+    global FRAME_REFRESH_LAST_AT
+    now = time.monotonic()
+    if now - FRAME_REFRESH_LAST_AT < FRAME_REFRESH_MIN_INTERVAL_SECONDS:
+        return web.json_response(
+            {"status": "coalesced", "requestedAt": int(time.time() * 1000)}
+        )
+    FRAME_REFRESH_LAST_AT = now
+
+    adb = os.environ.get(
+        "ANDROID_ADB", "/home/cherry/android-sdk/platform-tools/adb"
+    )
+    serial = os.environ.get("ANDROID_SERIAL", "emulator-5554")
+    package = os.environ.get("ANDROID_PACKAGE", "com.malldemomobile.safe")
+    activity = os.environ.get(
+        "ANDROID_ACTIVITY", "com.malldemomobile.MainActivity"
+    )
+    if not os.path.isfile(adb) or not os.access(adb, os.X_OK):
+        logging.error("Frame refresh cannot access configured adb executable.")
+        return web.json_response({"error": "frame refresh unavailable"}, status=503)
+
+    process = await asyncio.create_subprocess_exec(
+        adb,
+        "-s",
+        serial,
+        "shell",
+        "am",
+        "start",
+        "-W",
+        "--activity-single-top",
+        "-a",
+        f"{package}.REFRESH_FRAME",
+        "-n",
+        f"{package}/{activity}",
+        stdout=asyncio.subprocess.DEVNULL,
+        stderr=asyncio.subprocess.DEVNULL,
+    )
+    try:
+        await asyncio.wait_for(process.wait(), timeout=3)
+    except asyncio.TimeoutError:
+        process.kill()
+        await process.wait()
+        logging.warning("Timed out while requesting an APK frame refresh.")
+        return web.json_response({"error": "frame refresh unavailable"}, status=503)
+    if process.returncode != 0:
+        logging.warning("APK frame refresh exited with status %s.", process.returncode)
+        return web.json_response({"error": "frame refresh unavailable"}, status=503)
+
+    logging.info("Requested one APK frame refresh.")
+    return web.json_response(
+        {"status": "requested", "requestedAt": int(time.time() * 1000)}
+    )
+
+
