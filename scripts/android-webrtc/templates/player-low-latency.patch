   _handlePeerConnectionTrack = (e: RTCTrackEvent) => {
+    // Remote-control video values responsiveness over a deep playback buffer.
+    // These receiver hints are advisory and not implemented by every browser,
+    // so keep the connection usable when a browser rejects either setter.
+    const receiver = e.receiver as RTCRtpReceiver & {
+      playoutDelayHint?: number | null;
+      jitterBufferTarget?: number | null;
+    };
+    try {
