+def parse_interaction_ack_line(line):
+    marker_at = line.find(INTERACTION_LOG_PREFIX)
+    if marker_at < 0:
+        return None
+    try:
+        payload = json.loads(line[marker_at + len(INTERACTION_LOG_PREFIX):])
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+    if not isinstance(payload, dict):
+        return None
+    version = payload.get("version")
+    native_sequence = payload.get("sequence")
+    action = payload.get("action")
+    elapsed_realtime_ms = payload.get("androidElapsedRealtimeMs")
+    if (
+        version != 1
+        or type(native_sequence) is not int
+        or native_sequence < 1
+        or not isinstance(action, str)
+        or not INTERACTION_ACTION_PATTERN.fullmatch(action)
+        or type(elapsed_realtime_ms) is not int
+        or elapsed_realtime_ms < 0
+    ):
+        return None
+    return {
+        "version": 1,
+        "appSequence": native_sequence,
+        "action": action,
+        "androidElapsedRealtimeMs": elapsed_realtime_ms,
+    }
+
