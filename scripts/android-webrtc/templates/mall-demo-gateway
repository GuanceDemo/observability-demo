#!/usr/bin/env python3
"""Start the native-input gateway only after the mall emulator is ready."""
import asyncio
import os
from pathlib import Path
import sys

sys.path.insert(0, '/opt/mall-demo-webrtc/latest-video')
from discovery import wait_for_emulator


async def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/1002'))
    props = await wait_for_emulator(runtime / 'avd/running', grpc_port=8554)
    executable = '/opt/mall-demo-webrtc/android-emulator-container-scripts/gateway/venv/bin/videobridge-gateway'
    os.execv(executable, [executable, '--port=8080',
                          '--discovery_file=' + props['discovery.path']])


if __name__ == '__main__':
    try:
        asyncio.run(main())
    except TimeoutError:
        print('emulator gRPC discovery file was not ready', file=sys.stderr)
        sys.exit(1)
