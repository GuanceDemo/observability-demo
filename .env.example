# Copy to .env before running Docker Compose. Replace both change-me values.
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root
DEMO_PORT=8080

# Optional: connect the application containers to a DataKit reachable from Docker.
DATAKIT_HOST=host.docker.internal
# With compose.datakit.yaml, use the DataKit container name and its external network.
DATAKIT_DOCKER_NETWORK=datakit-demo-net
DD_TRACE_SAMPLE_RATE=1.0
DD_ENV=demo
DD_VERSION=local
PROJECT_TAG=mall-demo
GAME_PROJECT_TAG=game-demo
# Database dependency service name; keep it distinct from other projects.
DD_SERVICE_MAPPING=mysql:mall-mysql

# Select which platform DataKit reports to. This drives the UI label and default console URL;
# DataKit's own dataway_url must point to the same platform.
DATAKIT_PROVIDER=guance

# RUM is intentionally off until an application is created in Guance or TrueWatch.
RUM_ENABLED=false
RUM_APPLICATION_ID=
# Create a second Web RUM application for the WebGL game.
RUM_GAME_APPLICATION_ID=
RUM_GAME_SERVICE=mall-game-h5
# React Native RUM is configured separately per platform and remains disabled by default.
MOBILE_RUM_ENABLED=false
MOBILE_RUM_ANDROID_APPLICATION_ID=
MOBILE_RUM_IOS_APPLICATION_ID=
MOBILE_RUM_SESSION_REPLAY_ENABLED=true
# Optional Trace deep link. A workspace ID is required before the UI emits links.
# Leave the URL empty to use the provider default:
# guance -> https://console.guance.com/; truewatch -> https://ap1-console.truewatch.com/
OBSERVABILITY_CONSOLE_URL=
OBSERVABILITY_WORKSPACE_ID=

# External Agent for plain-Java business images >=2.4.0.
DDTRACE_VERSION=v1.65.6-ext
DDTRACE_INIT_REPOSITORY=pubrepo.truewatch.com/datakit-operator/dd-lib-java-init

# Optional EdgeFlow 1.0.1 tail-sampling overlay (compose.edgeflow.yaml).
# Generate a random admin token (e.g. `openssl rand -hex 24`) and set your workspace Dataway token.
EDGEFLOW_ADMIN_TOKEN=
EDGEFLOW_DEMO_TOKEN=
EDGEFLOW_CONFIG_PATH=./observability/edgeflow/edgeflow.toml

# Optional FlowPorts 0.5.13 data gateway overlay (compose.flowports.yaml).
# Leave the password empty to initialize through the FlowPorts setup wizard.
# FLOWPORTS_ADMIN_PASSWORD=
# FLOWPORTS_ADMIN_PORT=18082
# FLOWPORTS_INGEST_PORT=18083
# FLOWPORTS_SOCKET_PORT=1515
# FLOWPORTS_SOCKET_PROTOCOL=udp
# FLOWPORTS_UI_URL=http://127.0.0.1:18082
