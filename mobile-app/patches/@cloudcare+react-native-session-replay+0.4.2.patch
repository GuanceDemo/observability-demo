@@ -0,0 +1,84 @@
+package com.ft.sdk.reactnative.sessionreplay.utils;
+
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import java.util.Arrays;
+
+/** Immutable style snapshot. Rasterization happens on the SDK worker, never against a live View. */
+public final class BorderSnapshotDrawable extends Drawable {
+  private final int width;
+  private final int height;
+  private final int background;
+  private final float radius;
+  private final float[] edges;
+  private final int[] colors;
+
+  public BorderSnapshotDrawable(int width, int height, int background, float radius, float[] edges, int[] colors) {
+    this.width = width;
+    this.height = height;
+    this.background = background;
+    this.radius = radius;
+    this.edges = edges.clone();
+    this.colors = colors.clone();
+    setBounds(0, 0, width, height);
+  }
+
+  public BorderSnapshotDrawable copy() {
+    return new BorderSnapshotDrawable(width, height, background, radius, edges, colors);
+  }
+
+  public String cacheKey() {
+    return "rn-border-v1:" + width + ":" + height + ":" + background + ":" + radius
+        + ":" + Arrays.toString(edges) + ":" + Arrays.toString(colors);
+  }
+
+  @Override public int getIntrinsicWidth() { return width; }
+  @Override public int getIntrinsicHeight() { return height; }
+  @Override public void setAlpha(int alpha) { /* opacity belongs to the wireframe */ }
+  @Override public void setColorFilter(ColorFilter filter) {}
+  @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+
+  @Override public void draw(Canvas canvas) {
+    Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    float r = Math.max(0f, Math.min(radius, Math.min(width, height) / 2f));
+    Path outer = new Path();
+    outer.addRoundRect(new RectF(0, 0, width, height), r, r, Path.Direction.CW);
+    paint.setColor(background);
+    canvas.drawPath(outer, paint);
+    float l = Math.min(edges[0], width), t = Math.min(edges[1], height);
+    float right = Math.max(l, width - edges[2]), bottom = Math.max(t, height - edges[3]);
+    Path border = new Path(outer);
+    border.setFillType(Path.FillType.EVEN_ODD);
+    if (right > l && bottom > t) {
+      border.addRoundRect(new RectF(l, t, right, bottom), new float[] {
+          Math.max(0, r-l), Math.max(0, r-t), Math.max(0, r-edges[2]), Math.max(0, r-t),
+          Math.max(0, r-edges[2]), Math.max(0, r-edges[3]), Math.max(0, r-l), Math.max(0, r-edges[3])
+      }, Path.Direction.CW);
+    }
+    int save = canvas.save();
+    canvas.clipPath(border);
+    try {
+      drawEdge(canvas, paint, 0, new float[] {0,0, l,t, l,bottom, 0,height});
+      drawEdge(canvas, paint, 1, new float[] {0,0, width,0, right,t, l,t});
+      drawEdge(canvas, paint, 2, new float[] {width,0, width,height, right,bottom, right,t});
+      drawEdge(canvas, paint, 3, new float[] {0,height, l,bottom, right,bottom, width,height});
+    } finally {
+      canvas.restoreToCount(save);
+    }
+  }
+
+  private void drawEdge(Canvas canvas, Paint paint, int edge, float[] points) {
+    if (edges[edge] <= 0) return;
+    Path polygon = new Path();
+    polygon.moveTo(points[0], points[1]);
+    for (int i = 2; i < points.length; i += 2) polygon.lineTo(points[i], points[i+1]);
+    polygon.close();
+    paint.setColor(colors[edge]);
+    canvas.drawPath(polygon, paint);
+  }
+}
