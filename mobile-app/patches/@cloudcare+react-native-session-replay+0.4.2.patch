+/*
+ * React Native 0.86 removed CSSBackgroundDrawable and made its replacement
+ * internal. Keep the replay integration isolated from that internal class by
+ * reading the stable rendering fields through the SDK reflection helper.
+ */
+package com.ft.sdk.reactnative.sessionreplay.utils;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.ColorFilter;
+import android.content.Context;
+import android.graphics.RectF;
+import android.graphics.PixelFormat;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.InsetDrawable;
+import android.graphics.drawable.LayerDrawable;
+
+import com.facebook.react.uimanager.style.ComputedBorderRadius;
+import com.facebook.react.uimanager.style.BorderInsets;
+import com.facebook.react.uimanager.style.ColorEdges;
+import com.ft.sdk.reactnative.sessionreplay.extensions.ComputedBorderRadiusExt;
+import com.ft.sdk.reactnative.sessionreplay.mappers.Pair;
+import com.ft.sdk.sessionreplay.model.ShapeBorder;
+import com.ft.sdk.sessionreplay.model.ShapeStyle;
+
+public class ReactViewBackgroundDrawableUtils extends DrawableUtils {
+  private static final String BACKGROUND_DRAWABLE =
+      "com.facebook.react.uimanager.drawable.BackgroundDrawable";
+  private static final String BORDER_DRAWABLE =
+      "com.facebook.react.uimanager.drawable.BorderDrawable";
+  private static final String COMPUTED_BORDER_RADIUS_FIELD = "computedBorderRadius";
+  private static final String BACKGROUND_COLOR_FIELD = "backgroundColor";
+  private final ReflectionUtils reflectionUtils;
+
+  public ReactViewBackgroundDrawableUtils() {
+    this(new ReflectionUtils());
+  }
+
+  public ReactViewBackgroundDrawableUtils(ReflectionUtils reflectionUtils) {
+    this.reflectionUtils = reflectionUtils;
+  }
+
+  public static class BackgroundDrawableWrapper extends Drawable {
+    public final String backgroundColor;
+    public final float cornerRadius;
+    public final BorderSnapshot border;
+
+    public BackgroundDrawableWrapper(String backgroundColor, float cornerRadius) {
+      this(backgroundColor, cornerRadius, null);
+    }
+
+    public BackgroundDrawableWrapper(String backgroundColor, float cornerRadius, BorderSnapshot border) {
+      this.backgroundColor = backgroundColor;
+      this.cornerRadius = cornerRadius;
+      this.border = border;
+    }
+
+    @Override
+    public void draw(Canvas canvas) {}
+
+    @Override
+    public void setAlpha(int alpha) {}
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {}
+
+    @Override
+    public int getOpacity() {
+      return PixelFormat.OPAQUE;
+    }
+  }
+
+  @Override
+  public Pair<ShapeStyle, ShapeBorder> resolveShapeAndBorder(
+      Drawable drawable,
+      float opacity,
+      float pixelDensity) {
+    BackgroundDrawableWrapper wrapper = toWrapper(drawable);
+    if (wrapper == null) {
+      return new Pair<>(null, null);
+    }
+    return new Pair<>(
+        new ShapeStyle(wrapper.backgroundColor, opacity, wrapper.cornerRadius),
+        wrapper.border == null ? null : wrapper.border.uniformBorder());
+  }
+
+  @Override
+  public Drawable getReactBackgroundFromDrawable(Drawable drawable) {
+    if (drawable instanceof BackgroundDrawableWrapper) return drawable;
+    Drawable background = findLayer(drawable, BACKGROUND_DRAWABLE);
+    Drawable borderDrawable = findLayer(drawable, BORDER_DRAWABLE);
+    if (background == null && borderDrawable == null) return null;
+    BackgroundDrawableWrapper fill = toWrapper(background);
+    BorderSnapshot border = readBorder(borderDrawable);
+    ComputedBorderRadius radius = getComputedBorderRadius(borderDrawable);
+    return new BackgroundDrawableWrapper(
+        fill == null ? ColorUtils.formatAsRgba(Color.TRANSPARENT) : fill.backgroundColor,
+        fill == null ? (radius == null ? 0f : ComputedBorderRadiusExt.getAverage(radius)) : fill.cornerRadius,
+        border);
+  }
+
+  private Drawable findLayer(Drawable drawable, String className) {
+    if (drawable == null) return null;
+    if (className.equals(drawable.getClass().getName())) return drawable;
+    if (drawable instanceof InsetDrawable) {
+      return findLayer(((InsetDrawable) drawable).getDrawable(), className);
+    }
+    if (drawable instanceof LayerDrawable) {
+      LayerDrawable layers = (LayerDrawable) drawable;
+      for (int index = 0; index < layers.getNumberOfLayers(); index++) {
+        Drawable layer = findLayer(layers.getDrawable(index), className);
+        if (layer != null) {
+          return layer;
+        }
+      }
+    }
+    return null;
+  }
+
+  private BorderSnapshot readBorder(Drawable drawable) {
+    if (drawable == null) return null;
+    Object insets = reflectionUtils.getDeclaredField(drawable, "borderInsets");
+    Object context = reflectionUtils.getDeclaredField(drawable, "context");
+    Object colors = reflectionUtils.getDeclaredField(drawable, "computedBorderColors");
+    if (!(insets instanceof BorderInsets) || !(context instanceof Context) || !(colors instanceof ColorEdges)) return null;
+    RectF widths = ((BorderInsets) insets).resolve(drawable.getLayoutDirection(), (Context) context);
+    ColorEdges edges = (ColorEdges) colors;
+    return new BorderSnapshot(widths.left, widths.top, widths.right, widths.bottom,
+        edges.getLeft(), edges.getTop(), edges.getRight(), edges.getBottom());
+  }
+
+  @Override
+  public BorderSnapshotDrawable resolveBorderImage(Drawable drawable, int width, int height, float density) {
+    BackgroundDrawableWrapper wrapper = toWrapper(drawable);
+    if (wrapper == null || wrapper.border == null || wrapper.border.uniformBorder() != null) return null;
