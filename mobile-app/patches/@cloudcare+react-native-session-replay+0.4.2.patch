+      colors = new int[] {leftColor, topColor, rightColor, bottomColor};
+    }
+
+    private static float clean(float width) { return Float.isFinite(width) ? Math.max(0f, width) : 0f; }
+
+    public ShapeBorder uniformBorder() {
+      if (widths[0] <= 0f || widths[0] != Math.round(widths[0])) return null;
+      for (int i = 1; i < 4; i++) {
+        if (widths[i] != widths[0] || colors[i] != colors[0]) return null;
+      }
+      return new ShapeBorder(ColorUtils.formatAsRgba(colors[0]), Math.round(widths[0]));
+    }
+  }
+
+  private BackgroundDrawableWrapper toWrapper(Drawable drawable) {
+    if (drawable instanceof BackgroundDrawableWrapper) {
+      return (BackgroundDrawableWrapper) drawable;
+    }
+    if (drawable == null || !BACKGROUND_DRAWABLE.equals(drawable.getClass().getName())) {
+      return null;
+    }
+    Integer backgroundColor = getBackgroundColor(drawable);
+    if (backgroundColor == null) {
+      backgroundColor = Color.TRANSPARENT;
+    }
+    ComputedBorderRadius radius = getComputedBorderRadius(drawable);
+    return new BackgroundDrawableWrapper(
+        ColorUtils.formatAsRgba(backgroundColor),
+        radius == null ? 0f : ComputedBorderRadiusExt.getAverage(radius));
+  }
+
+  private Integer getBackgroundColor(Object drawable) {
+    Object value = reflectionUtils.getDeclaredField(drawable, BACKGROUND_COLOR_FIELD);
+    return value instanceof Integer ? (Integer) value : null;
+  }
+
+  private ComputedBorderRadius getComputedBorderRadius(Object drawable) {
+    Object value =
+        reflectionUtils.getDeclaredField(drawable, COMPUTED_BORDER_RADIUS_FIELD);
+    return value instanceof ComputedBorderRadius ? (ComputedBorderRadius) value : null;
+  }
+}
